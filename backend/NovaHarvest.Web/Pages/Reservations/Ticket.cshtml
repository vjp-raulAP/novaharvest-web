@page "/ticket"

@{
    Layout = null;

    string reserva = "RES-0001";
    string producto = "Cereza Picota";
    int kilos = 20;
    string recogida = "Cooperativa del Valle del Jerte";
    DateTime fechaGeneracion= DateTime.Now;
}


<!DOCTYPE html>
    <html lang= "es">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content= "width=device-width, initial-scale=1.0">
            <title>Justificante de reserva - NovaHarvest</title>
            <link rel="stylesheet" href="/css/site.css">
        </head>

        <body>
            <h1> Justificante de reserva</h1>
                <p>Reserva: @reserva</p>
                <p>Producto: @producto</p>
                <p>Kilos: @kilos</p>
                <p>Recogida: @recogida</p>
                <p>Generado el @fechaGeneracion.ToString("dd/MM/yyyy HH:mm") (fecha y hora del servidor)</p>
        </body>
    </html>