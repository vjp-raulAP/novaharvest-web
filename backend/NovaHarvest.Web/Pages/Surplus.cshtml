@page
@model SurplusModel

@{
    ViewData["Title"] = "Excedente";
}

<h1>Excedente agrícola</h1>

<p>Producto: @Model.Excedente.Product</p>

<p>Productor: @Model.Excedente.Producer</p>

<p>Precio original: @Model.Excedente.PricePerKg</p>

<p>Cosecha: @Model.Excedente.HarvestDate.ToString("dd/MM/yyyy")</p>

<p>Consumir antes del: @Model.FechaLimite.ToString("dd/MM/yyyy")</p>
<p>Precio con descuento: @Model.PrecioExcedente</p>

@if (Model.DiasParaConsumir <= 2 && Model.KilosDisponibles > 0)
        {
          <p class = "urgent">Días para consumirlo: @Model.DiasParaConsumir</p>  
        }
        else
        {
         <p>Días para consumirlo: @Model.DiasParaConsumir</p>   
        }
<p>Precio original: @Model.Excedente.PricePerKg.ToString("F2") € / kg</p>

<p>Precio de excedente: @Model.PrecioExcedente.ToString("F2") € / kg</p>

<p>Kilos disponibles: @Model.KilosDisponibles</p>

<p>@Model.CajasDisponibles cajas de 5 kg y @Model.KilosSueltos kg sueltos</p>

<p> Valor del excedente: @Model.ValorExcedente.ToString("F2") €</p>

<p>Estado: @Model.EstadoExcedente</p>

<p>Nota del productor: @(Model.Excedente.Note ?? "Sin observaciones")</p>

@* boton aparece deshabilitado cuando el producto está agotado*@
@if (Model.KilosDisponibles > 0)
    {
        <a href = "/ticket">Reservar</a> 
    }
    else
    {
        <button disabled>Reservar</button>
    }